# Generate a hex password, which can safely be interpolated into a PostgreSQL URL.
POSTGRES_PASSWORD=replace-with-a-generated-hex-password
EYES_GLOBAL_EXECUTION_LIMIT=16
EYES_GLOBAL_SCORE_LIMIT=4
EYES_SCORE_SUBMISSION_GRACE_SECONDS=60
EYES_MAX_SCORE_INPUT_BYTES=33554432
# Observation content retention is disabled by default; enabled policy needs a project.
EYES_OBSERVATION_RETENTION_DAYS=0
# EYES_OBSERVATION_RETENTION_PROJECT_ID=<project UUID>
EYES_OBSERVATION_RETENTION_RUN_BATCH=20
EYES_OBSERVATION_RETENTION_EVENT_BATCH=500
EYES_OBSERVATION_RETENTION_MAX_BATCHES=10
# Start the existing optional maintenance profile to run hourly maintenance.
