EYES_DATABASE_URL=postgresql+psycopg://eyes:eyes@127.0.0.1:5432/eyes
EYES_ARTIFACT_ROOT=data/artifacts
EYES_GLOBAL_EXECUTION_LIMIT=16
EYES_GLOBAL_SCORE_LIMIT=4
EYES_LEASE_SECONDS=60
EYES_CANCELLATION_GRACE_SECONDS=60
EYES_SCORE_SUBMISSION_GRACE_SECONDS=60
EYES_SCHEDULER_INTERVAL_SECONDS=5
EYES_MAX_REQUEST_BYTES=8388608
EYES_MAX_SCORE_INPUT_BYTES=33554432
EYES_MAX_ARTIFACT_BYTES=33554432
# Optional per-project retained Event + ObservedEvent JSON text quota (not PG disk bytes).
EYES_PROJECT_EVENT_CONTENT_BYTES=0
# Optional minimum available bytes on the artifact filesystem; 0 disables admission check.
EYES_ARTIFACT_MIN_FREE_BYTES=0
EYES_CAPACITY_WARNING_PERCENT=90
EYES_MAX_DATASET_CASES=10000
EYES_MAX_EXPERIMENT_RUNS=100000
EYES_MAX_PREPARATION_ATTEMPTS=3
EYES_TRACE_CONSOLE_EXPORT=false
# Optional explicit legacy-request window; disabled by default, ends no later than this instant.
# Requires X-Eyes-Legacy-Schema: 1.0 on each legacy request.
# EYES_LEGACY_SCHEMA_UNTIL=2026-11-01T00:00:00Z
# 0 disables age-based evidence expiration. File cleanup uses the grace periods below.
EYES_EVIDENCE_RETENTION_DAYS=0
# Observation JSONB content, separate from experimental evidence. 0 keeps live content.
EYES_OBSERVATION_RETENTION_DAYS=0
# Required when enabling observation expiration; may also use maintain --project-id.
# EYES_OBSERVATION_RETENTION_PROJECT_ID=<project UUID>
EYES_OBSERVATION_RETENTION_RUN_BATCH=20
EYES_OBSERVATION_RETENTION_EVENT_BATCH=500
EYES_OBSERVATION_RETENTION_MAX_BATCHES=10
EYES_PENDING_ARTIFACT_TTL_HOURS=24
EYES_ORPHAN_ARTIFACT_GRACE_HOURS=24

# eyes-server enables local ingestion on its loopback-only listener by default.
# Generic ASGI/remote deployments default to false; do not enable behind a proxy.
# EYES_LOCAL_OBSERVATION=false
# With multiple projects, choose which receives local Agent events.
# EYES_LOCAL_OBSERVATION_PROJECT_ID=<project UUID>
